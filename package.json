{
  "name": "causal-verdict-cre",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Causal-Verdict CRE — RYO-CHAN MCP autonomous practice-trade agent with Chainlink CRE anchoring and a bidirectional fiduciary mandate compiler.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "tsx server/serve.ts",
    "capture": "node scripts/capture-ryo.mjs && tsx scripts/capture-feeds.ts",
    "test": "tsx scripts/selftest.ts",
    "contract:compile": "node scripts/compile-contract.mjs",
    "cre:simulate": "tsx cre-workflow/simulate.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "capture:feeds": "tsx scripts/capture-feeds.ts",
    "cre:compile": "cd cre-workflow/causal-verdict && npm install && npm run compile"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "solc": "^0.8.24",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=20"
  }
}
